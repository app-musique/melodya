# === Supabase (obligatoire) ===
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Paroles (Claude) ===
# Vide => génération en mode gabarit (aucun appel réseau)
ANTHROPIC_API_KEY=

# === Génération musicale ===
# mock | suno
MUSIC_PROVIDER=mock
# sunoapi.org — base URL de l'API (PAS la page où l'on récupère la clé)
SUNO_API_BASE_URL=https://api.sunoapi.org
SUNO_API_KEY=
# V4 | V4_5 | V4_5PLUS | V5 | V5_5   (défaut : V4_5)
SUNO_MODEL=V4_5

# === Paiement (Moneroo) ===
# Vide => paiement simulé (l'app marque la commande payée sans redirection externe)
MONEROO_SECRET_KEY=
MONEROO_WEBHOOK_SECRET=

# === Emails transactionnels (Brevo) ===
# Vide => emails simulés (log serveur uniquement).
# Brevo > SMTP & API > API Keys. L'expéditeur (EMAIL_FROM) doit être un « sender »
# vérifié dans Brevo (Senders & IP).
BREVO_API_KEY=
EMAIL_FROM=Muzikii <muzikii2026@gmail.com>
EMAIL_REPLY_TO=

# === Cron (filet de sécurité génération) ===
# Vide => la route /api/cron/tick répond 401 (inactif, sans risque).
# Optionnel : mettre une valeur aléatoire 32+ car. puis appeler périodiquement
# GET /api/cron/tick avec l'en-tête "Authorization: Bearer <valeur>" — via un cron
# Vercel (Settings > Cron Jobs, plan Pro) ou un service gratuit type cron-job.org.
CRON_SECRET=
