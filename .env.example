# === Supabase (obligatoire) ===
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Paroles (Claude) ===
# Vide => génération en mode gabarit (aucun appel réseau)
ANTHROPIC_API_KEY=

# === Génération musicale ===
# mock | suno
MUSIC_PROVIDER=mock
# API HTTP compatible Suno (ex. fournisseur tiers). Vide => mode mock quel que soit MUSIC_PROVIDER
SUNO_API_BASE_URL=
SUNO_API_KEY=

# === Paiement (Moneroo) ===
# Vide => paiement simulé (l'app marque la commande payée sans redirection externe)
MONEROO_SECRET_KEY=
MONEROO_WEBHOOK_SECRET=
