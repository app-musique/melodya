# === Supabase (obligatoire) ===
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Paroles (Claude) ===
# Vide => génération en mode gabarit (aucun appel réseau)
ANTHROPIC_API_KEY=

# === Génération musicale ===
# mock | suno
MUSIC_PROVIDER=mock
# sunoapi.org — base URL de l'API (PAS la page où l'on récupère la clé)
SUNO_API_BASE_URL=https://api.sunoapi.org
SUNO_API_KEY=
# V4 | V4_5 | V4_5PLUS | V5 | V5_5   (défaut : V4_5)
SUNO_MODEL=V4_5

# === Paiement (Moneroo) ===
# Vide => paiement simulé (l'app marque la commande payée sans redirection externe)
MONEROO_SECRET_KEY=
MONEROO_WEBHOOK_SECRET=
